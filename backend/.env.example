# ---------------------------------------------------------------------------
# BSF backend - environment template
# Copy to /etc/bsf-backend.env and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
# Set to 127.0.0.1 when nginx is the only reverse proxy in front of the API.
HOST=127.0.0.1

# Production TLS terminates at nginx. The Node processes stay on loopback.
PUBLIC_ORIGIN=https://client-dashboard.example.com
TRUST_PROXY=true
REQUIRE_HTTPS=true

# PostgreSQL connection string (local instance, least-privilege app user).
DATABASE_URL=postgresql://bsf_app:CHANGE_ME@127.0.0.1:5432/bsf

# Shared secret required on write endpoints (header: x-api-key).
# Generate with: openssl rand -hex 32
# Must be at least 24 characters in production.
INTERNAL_API_KEY=

# Comma separated list of origins allowed to call the API from a browser.
# Production requires explicit HTTPS origins; wildcard and HTTP are rejected.
CORS_ALLOWED_ORIGINS=https://client-dashboard.example.com

# ------------------------- Vendor authentication --------------------------
# Login is performed by the backend only. Generate the encryption key with:
#   openssl rand -base64 32
VENDOR_AUTH_ENABLED=true
AUTH_REQUIRED=true
VENDOR_LOGIN_URL=https://iot.creekscomposter.com:8888/user/login
VENDOR_DEVICE_LIST_URL=https://iot.creekscomposter.com:8888/emDevice/queryListData
# Use `json` first. Change to `form` only if the vendor requires x-www-form-urlencoded.
VENDOR_LOGIN_FORMAT=json
VENDOR_AUTH_TIMEOUT_MS=10000
VENDOR_DEVICE_TIMEOUT_MS=15000
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_COOKIE=bsf_session
AUTH_CSRF_COOKIE=bsf_csrf
# Keep true in production. Production login must be served over HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_IP_MAX_ATTEMPTS=30

# ------------------------- Email provider --------------------------------
# Values are supplied by the customer / mail vendor. Keep blank until then;
# the API will return EMAIL_PROVIDER_NOT_CONFIGURED instead of faking success.
EMAIL_PROVIDER=generic
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=BSF Smart Bin
EMAIL_REPLY_TO=

# ------------------------- WhatsApp provider -----------------------------
# Supports Meta WhatsApp Cloud API ("meta") or a generic HTTP vendor.
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_KEY_HEADER=Authorization

# ------------------------- Notification worker ---------------------------
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=60
WORKER_LOCK_TIMEOUT_SECONDS=300
PROVIDER_TIMEOUT_MS=15000

# ------------------------- Alerting defaults ------------------------------
ALERT_TEMP_HIGH_C=58
ALERT_TEMP_LOW_C=12
